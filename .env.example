# Token de una integración interna de Notion (https://www.notion.so/my-integrations).
# Hay que compartir la base "TSDS:claude-fechas" con esa integración para que pueda leer y escribir.
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Contraseña para poder editar desde la página (marcar hecho, cambiar títulos y fechas).
# Si falta o está vacía, la edición queda apagada: la página es solo lectura y no ofrece login. Usá una larga: no hay límite de intentos.
EDIT_PASSWORD=
